# Public site URL used for canonical links, Open Graph, sitemap, and robots.
# Set this to your production origin when deploying (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Future REST API base (unused until wired). Example:
# OLL_API_BASE_URL=https://api.example.com/v1

# OLL Bot / Diagnostic Pilot (Agents API + Go Pilot backend)
AGENTS_API_BASE_URL=
AGENTS_API_KEY=
AGENTS_AGENT_ID=
NEXT_PUBLIC_API_BASE_URL=

